{
  "name": "whoispk",
  "version": "2.0.0",
  "description": "Check .pk domain availability and registration details from PKNIC, from the command line or Node.js",
  "keywords": [
    "whois",
    "pk",
    "pknic",
    "whoispk",
    "pakistan",
    "domain",
    "availability",
    "cli"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "whoispk": "bin/whoispk.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node --test",
    "test:live": "WHOISPK_LIVE=1 node --test",
    "fixtures": "node scripts/update-fixtures.js"
  },
  "author": {
    "name": "Abbas Siddiqi",
    "email": "abbas.siddiqi1@gmail.com",
    "url": "https://abbassiddiqi.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abbassiddiqi/whoispk.git"
  },
  "bugs": {
    "url": "https://github.com/abbassiddiqi/whoispk/issues"
  },
  "homepage": "https://github.com/abbassiddiqi/whoispk#readme",
  "license": "MIT"
}
